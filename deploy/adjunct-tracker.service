[Unit]
Description=SUSCC Adjunct Tracker API
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/adjunct-tracker/backend
Environment="PATH=/var/www/adjunct-tracker/backend/venv/bin"
ExecStart=/var/www/adjunct-tracker/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=10

# Security
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/adjunct-tracker/backend

[Install]
WantedBy=multi-user.target
