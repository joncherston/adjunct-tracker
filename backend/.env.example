# Application Settings
APP_NAME=SUSCC Adjunct Tracker
DEBUG=True
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
BASE_URL=http://localhost:5173

# Database
DATABASE_URL=sqlite:///./adjunct_tracker.db
# For PostgreSQL (production): postgresql://user:password@localhost/adjunct_tracker

# JWT Authentication
JWT_SECRET_KEY=another-secret-key-here-generate-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# Email Configuration (Brevo)
BREVO_API_KEY=your-brevo-api-key-here
FROM_EMAIL=noreply@suscholarsbowl.com
FROM_NAME=SUSCC Adjunct Committee
ADMIN_EMAIL=adjunct-chair@suscholarsbowl.com

# CORS
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Application URLs
API_PREFIX=/api
